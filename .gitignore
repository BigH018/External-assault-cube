# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Packaging / editable install
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Test / tooling caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Editors / OS
.vscode/
.idea/
Thumbs.db
Desktop.ini

# Local data: only the default profile is committed
profiles/*.json
!profiles/default.json
profiles/.last_profile
logs/
*.log
